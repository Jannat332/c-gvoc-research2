\newlabel{tab:model_breakdowns}{{4}{11}{\textbf {Model-Stratified Performance Breakdowns Across All 4 Foundation Backbones ($N = 4,000$ each).}}{table.caption.15}{}}
\newlabel{tab:ablations}{{5}{11}{\textbf {Systematic Component Ablation Study ($N = 2,000$ Stratified Subset).} Full \textsc {GVoC} scores 70.5\% / 272 tokens on this stratified ablation split, consistent with 70.2\% / 274 tokens across the full 16,000-query benchmark (Table~\ref {tab:headline_benchmark}). Removing cost normalization ($\mathcal {V} = \Delta P_a$) yields negligible accuracy gain (+0.6\%) while inflating token cost by +51.5\% and regret by 4.5$\times $}{table.caption.19}{}}
\newlabel{tab:stress_test}{{6}{11}{\textbf {Abstention Stress Test on 1,000 Corrupted Documents.} Percentage of unanswerable queries where models correctly refrain from guessing ($a_{\text {abstain}}$) vs. hallucinating}{table.caption.21}{}}
\def\@LN@column{2}
\newlabel{tab:master_benchmark_app}{{7}{12}{\textbf {Master Head-to-Head Comparative Benchmark Matrix ($N = 16,000$ Queries).} Evaluated across 4 backbones (64,000 sessions, 384,000 runs). $^\dagger $Significant over MACT ($p < 0.001$). Accuracy reflects verified correctness; Regret quantifies empirical loss divergence from oracle $\mathcal {A}^*$. The Deterministic Rule baseline reaches 89.0\% accuracy by firing tools unconditionally on $>85\%$ of queries (368 tokens, $+34.3\%$ over \textsc {GVoC}), incurring high Type-I regret. \textsc {GVoC} optimizes the accuracy--compute--regret Pareto frontier, delivering 70.2\% accuracy at 274 tokens with lowest regret (0.412)}{table.caption.22}{}}

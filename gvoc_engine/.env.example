# ==============================================================================
# GVoC Engine - API Credentials Example
# ==============================================================================
# NOTE: In this repository, keys are automatically resolved from your secure 
# folder (C:\Users\user\Desktop\tokens_essential\.env) at runtime if not set here.
# DO NOT paste real keys into this file.
# ==============================================================================

# Google Gemini API (Recommended for VDU reasoning)
GOOGLE_API_KEY=

# Groq API (High-speed inference + multi-key rotation)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# OpenRouter API (Qwen2-VL, Llama-Vision + multi-key rotation)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Mistral AI (Optional)
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
